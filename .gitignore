# ==============================================================================
# CyberFusion XDR Enterprise - Comprehensive .gitignore
# ==============================================================================

# 1. Sensitive Environment Files & API Secrets (DO NOT COMMIT)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# 2. Python Virtual Environments & Packages
venv/
venv*/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 3. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 4. Large Databases & Telemetry Storage (>100MB will be rejected by GitHub)
*.db
*.db-journal
*.sqlite
*.sqlite3
cyberfusion_enterprise.db
cyberfusion.db
backend/cyberfusion_enterprise.db
backend/cyberfusion.db
backend/data/learning_profiles/test-*.json

# 5. Node / Frontend Dependencies & Production Builds
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# 6. Log Files & Runtime Outputs
*.log
backend.log
frontend.log
agent.log
logs/

# 7. OS Generated & Temporary Files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# 8. IDE & Editor Specific Files
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
